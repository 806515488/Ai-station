# 复制本文件到 src/.env 并填 key（src/.env 不入库）。
# station 宿主与 archive 引擎都从 src/.env 读这些（env 变量同名优先）。

# —— 三家 OpenAI 兼容端点，任配其一即可跑文本/视觉 ——
# 09-10 起这些是**兜底**：界面顶栏「⚙ 模型配置」里给某个 provider 填了 key 就优先用那份，
# 留空才回落到这里。哪个槽位用哪家、按什么顺序降级，也都在那个弹窗里配（存 DB、按用户分）。
GLM_API_KEY=
QWEN_API_KEY=
DEEPSEEK_API_KEY=

# —— 通道选择（可选；只是"没配过界面配置时的默认值"）——
# TEXT_CHANNEL 同时是「对话主模型」和「识别·定类」两个槽位的默认链首；
# VISION_CHANNEL 管「识别·建档」；ROUTE_CHANNEL 管「路由判词」（老写法 qwen-flash 仍兼容）。
TEXT_CHANNEL=glm
VISION_CHANNEL=qwen

# —— station 宿主开关（可选）——
STATION_MAX_STEPS=10        # agent 一轮最多工具步数
STATION_AUTO_APPROVE=0      # 1=危险工具免确认（仅本机调试）
STATION_COMPACT_TOKENS=0    # >0 才启用超长对话自动压缩（token 阈值）
STATION_FAKE=0              # 1=用离线 FakeModel 冒烟 harness（不烧 key）
STATION_STREAM=1            # 1=模型回复逐字流出（默认）；0=退回"整段生成完再显示"
STATION_STREAM_DELAY=0      # >0 时让离线假模型慢慢吐字，只为肉眼确认 SSE 真在流（仅 STATION_FAKE 下有效）
ROUTE_CHANNEL=qwen-flash    # 路由判词的默认链首（qwen-flash 是 qwen 家的判词模型名，老写法兼容）
ROUTE_THRESHOLD=0.8         # L2 置信度门：低于它降级给主 agent
ROUTE_TIMEOUT=10            # L2 判词**墙钟**预算（秒）：超了降级。别调回 1.5 —— 进程内第一次调用要 2~3 秒（冷启动），那样判词每次都超时白等
ROUTE_LOG=1                 # 1=每次路由判定写 data/station/route_log.jsonl（校准阈值用）
