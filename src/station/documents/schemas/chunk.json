{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "chunk_id", "document_id", "revision_id", "parsed_snapshot_id", "chunk_set_id", "chunk_index", "kind", "text", "source_spans", "metadata", "strategy", "quality"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "chunk_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "document_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "revision_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "parsed_snapshot_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "chunk_set_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "chunk_index": {"type": "integer", "minimum": 1},
    "text": {"type": "string", "minLength": 1},
    "source_spans": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["block_id", "start", "end", "role"], "properties": {
        "block_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "role": {"enum": ["body", "context"]}
      }
    }},
    "metadata": {"type": "object", "required": ["source_name", "owner_id", "source_locations", "extraction_scope"]},
    "strategy": {"type": "object", "required": ["id", "version", "length_unit", "config_fingerprint"]},
    "quality": {"type": "object"}
  }
}
