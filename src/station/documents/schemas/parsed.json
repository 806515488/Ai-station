{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "document_id", "revision_id", "parsed_snapshot_id", "block_id", "unit_id", "unit_part_index", "unit_text_start", "order", "type", "raw_text", "text", "loader_metadata", "source_locations", "extraction", "capabilities", "transforms", "quality", "retrieval"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "document_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "revision_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "parsed_snapshot_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "block_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "unit_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "unit_part_index": {"type": "integer", "minimum": 1},
    "unit_text_start": {"type": "integer", "minimum": 0},
    "order": {"type": "integer", "minimum": 1},
    "type": {"type": "string"},
    "raw_text": {"type": ["string", "null"]},
    "raw_text_ref": {"type": ["string", "null"]},
    "text": {"type": "string"},
    "loader_metadata": {"type": "object"},
    "source_locations": {"type": "array", "minItems": 1},
    "extraction": {"type": "object"},
    "capabilities": {"type": "object", "required": ["extraction_scope"]},
    "transforms": {"type": "array"},
    "quality": {"type": "object"},
    "retrieval": {"type": "object", "required": ["exclude"]}
  },
  "allOf": [{"if": {"properties": {"raw_text": {"type": "null"}}}, "then": {
    "required": ["raw_text_ref"], "properties": {"raw_text_ref": {"type": "string", "minLength": 1}}
  }}]
}
