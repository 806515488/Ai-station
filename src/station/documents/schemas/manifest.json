{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "document_id", "run_id", "owner_id", "source", "processing", "parsed", "chunk_sets", "quality", "resources"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "document_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "run_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "owner_id": {"type": "string", "minLength": 1},
    "source": {"type": "object", "required": ["name", "sha256"]},
    "processing": {"type": "object", "required": ["config", "parse_fingerprint"]},
    "parsed": {"type": "object", "required": ["snapshot_id", "status", "block_count", "shards"], "properties": {
      "status": {"enum": ["ready", "unusable", "failed"]},
      "block_count": {"type": "integer", "minimum": 0},
      "shards": {"type": "array", "items": {"$ref": "#/$defs/shard"}}
    }},
    "chunk_sets": {"type": "array", "items": {"type": "object", "required": ["chunk_set_id", "status", "chunk_count", "shards"], "properties": {
      "status": {"enum": ["ready", "failed", "partial", "building"]},
      "chunk_count": {"type": "integer", "minimum": 0},
      "shards": {"type": "array", "items": {"$ref": "#/$defs/shard"}}
    }}},
    "quality": {"type": "object", "required": ["status", "issues"], "properties": {
      "status": {"enum": ["accepted", "needs_review", "partial", "unusable"]},
      "issues": {"type": "array"}
    }},
    "resources": {"type": "array"}
  },
  "$defs": {
    "shard": {"type": "object", "required": ["index", "path", "record_count", "byte_size", "sha256", "first_id", "last_id"], "properties": {
      "index": {"type": "integer", "minimum": 1},
      "path": {"type": "string", "minLength": 1},
      "record_count": {"type": "integer", "minimum": 1},
      "byte_size": {"type": "integer", "minimum": 1},
      "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    }}
  }
}
